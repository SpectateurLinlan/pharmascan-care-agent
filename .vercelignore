# Upload only the two Vercel projects and their public runtime dependencies.
/*
!/frontend/
!/backend/
/backend/*
!/backend/app/
!/deploy/
/deploy/*
!/deploy/dispatcher/
!/scripts/
/scripts/*
!/scripts/run_reminders.py
!/pyproject.toml
!/vercel.json
!/LICENSE
!/NOTICE

# Generic credentials, caches and generated files are never deployment inputs.
**/.*
**/node_modules/**
**/__pycache__/**
**/*.py[cod]
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
/frontend/dist/**
/frontend/test-results/**
/frontend/playwright-report/**
!/.python-version
!/.vercelignore
!/frontend/.vercelignore
