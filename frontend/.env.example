# Public Supabase Auth settings only. Leave empty for isolated local demo mode.
# Never put a service-role key, database URL, VAPID private key or model key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development proxy to FastAPI. The combined launcher overrides this per process.
VITE_API_TARGET=http://127.0.0.1:8001

# Production business requests use same-origin /api/... through vercel.json.
# VITE_API_BASE_URL is not consumed; do not configure it as a production API target.
