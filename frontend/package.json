{
  "name": "pharmascan-patient-ui",
  "private": true,
  "version": "1.0.0-rc.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:architecture": "node --test tooling/architecture.test.mjs && node tooling/architecture.mjs",
    "test": "vitest run --maxWorkers=1",
    "test:browser": "playwright test",
    "format": "prettier --config .prettierrc.json --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,tsx,html}\" \"tooling/*.mjs\" \"*.{js,ts,mjs}\" \"../scripts/**/*.js\"",
    "format:check": "prettier --config .prettierrc.json --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.{ts,tsx,html}\" \"tooling/*.mjs\" \"*.{js,ts,mjs}\" \"../scripts/**/*.js\""
  },
  "dependencies": {
    "@supabase/auth-js": "^2.109.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
