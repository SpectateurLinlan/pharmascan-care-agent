    "deploy/dispatcher/index.py": {
      "maxDuration": 60,
      "regions": [
        "sin1"
      ],
      "includeFiles": "{deploy/dispatcher/**,backend/app/**,scripts/run_reminders.py}",
      "excludeFiles": "{frontend/**,**/node_modules/**,**/__pycache__/**,**/.*,**/.*/**,**/*.py[cod],**/*.pem,**/*.key,**/*.p12,**/*.pfx,**/credentials.json}"
    }
  }
