# Configuration template — safe to commit.
# NEVER put real passwords, tokens, API keys, or other credentials in this file.

APP_ENV=development
APP_ORIGIN=
API_BASE_URL=

DATABASE_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only elevated Supabase key.
# Never expose this in Vite/frontend/browser code.
SUPABASE_SECRET_KEY=

VISION_API_BASE_URL=https://davidpansx-pharmascan-api.hf.space
VISION_API_TIMEOUT_SECONDS=12

TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

ENABLE_DEMO_SEED=true
ENABLE_SPEECH=false
ENABLE_CAREGIVER_NOTIFICATIONS=false
TENCENT_SPEECH_APPROVED=false
TENCENT_SPEECH_SITE=international
TENCENT_TTS_VOICE_TYPE=1050

STT_PROVIDER=browser
# Frontend-only default; no automatic paid fallback. Cloud needs explicit user selection.
# Optional: tencent + ENABLE_SPEECH/TENCENT_SPEECH_APPROVED and server-only credentials.
TTS_PROVIDER=browser

# Conversational reasoning (server only; no VITE_ keys)
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
DEMO_AGENT_DAILY_TURN_LIMIT=20
# Optional manual comparison only; never automatically selected
GEMINI_COMPARISON_MODEL=gemini-3.6-flash

# Email OTP/Magic Link/password reuse VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY.
# Configure redirect allowlist/email templates/manual linking in Supabase separately; never add SMTP secrets to VITE_.
# Singpass is future-only in About; no Singpass credential is needed.

# Patient health/summary revision needs migration014; no new secret/provider variable.
# Browser QA can use MODEL_PROVIDER=deterministic in the QA process to avoid paid model calls.

# Progressive evidence/private gallery needs migrations015-018; no new provider secret.
# Numeric text-size persistence needs migration019; no new environment setting.
# Private caregiver contact management needs migration020; no messaging provider is enabled.
# Gallery uses the existing VISION_API_BASE_URL and same-user Supabase JWT path.

# Stage2 uses the retained OpenAPI 0.10.0 snapshot at the existing VISION_API_BASE_URL.
# No automatic safety/feedback/training or cloud speech calls are enabled by this upgrade.

# Web Push (migrations021–023). Runtime switches stay off until configured.
# Generate locally: python scripts/create_vapid_keys.py (Git-ignored output; no keys printed).
# Patient API uses ENABLE_PUSH_SUBSCRIPTIONS and VAPID_PUBLIC_KEY only.
# ENABLE_WEB_PUSH, VAPID_PRIVATE_KEY and VAPID_SUBJECT are dispatcher-only.
ENABLE_PUSH_SUBSCRIPTIONS=false
ENABLE_WEB_PUSH=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Operator-controlled mailto: or HTTPS contact; not a patient address.
VAPID_SUBJECT=
## Worker-only HMAC secret (at least 32 random ASCII characters). Keep out of patient API/Vite.
## Generate/store privately only after owner approval; Cron signs timestamped requests using Vault.
PUSH_DISPATCH_TOKEN=
# DATABASE_URL is used only by explicit worker/migration scripts, never patient HTTP.
# Long-term medication care requires migrations022-023, not a new paid provider.
# Reuses existing Auth/JWT, Gemini and optional disabled Web Push configuration.

# Pending database extensions: enable only after their separate verification/release gates.
ENABLE_MEDICATION_LIBRARY_FILES=false
ENABLE_LATE_DOSE_REPORTS=false
# Library files require031. Late dose reports require033 and its reviewed dependencies.
# After033 report data exists, do not disable the late-report reader or roll back to raw events.

# Enable only after migration 032 and matching worker/backend are verified.
ENABLE_CARE_TASK_FOLLOWUPS=false
