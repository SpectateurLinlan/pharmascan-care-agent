# Configuration template — safe to commit.
# NEVER put real passwords, tokens, API keys, or other credentials in this file.

APP_ENV=development
APP_ORIGIN=
API_BASE_URL=

DATABASE_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only elevated Supabase key.
# Never expose this in Vite/frontend/browser code.
SUPABASE_SECRET_KEY=

VISION_API_BASE_URL=https://davidpansx-pharmascan-api.hf.space
VISION_API_TIMEOUT_SECONDS=12

TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

ENABLE_DEMO_SEED=true
ENABLE_SPEECH=false
ENABLE_CAREGIVER_NOTIFICATIONS=false
TENCENT_SPEECH_APPROVED=false
TENCENT_SPEECH_SITE=international
TENCENT_TTS_VOICE_TYPE=1050

STT_PROVIDER=browser
# Frontend-only default; no automatic paid fallback. Cloud needs explicit user selection.
# Optional: tencent + ENABLE_SPEECH/TENCENT_SPEECH_APPROVED and server-only credentials.
TTS_PROVIDER=browser

# Conversational reasoning (server only; no VITE_ keys)
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
DEMO_AGENT_DAILY_TURN_LIMIT=20
# Optional manual comparison only; never automatically selected
GEMINI_COMPARISON_MODEL=gemini-3.6-flash

# Email OTP/Magic Link/password reuse VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY.
# Configure redirect allowlist/email templates/manual linking in Supabase separately; never add SMTP secrets to VITE_.
# Singpass is future-only in About; no Singpass credential is needed.

# Patient health/summary revision needs migration014; no new secret/provider variable.
# Browser QA can use MODEL_PROVIDER=deterministic in the QA process to avoid paid model calls.

# Progressive evidence/private gallery needs migrations015-018; no new provider secret.
# Numeric text-size persistence needs migration019; no new environment setting.
# Private caregiver contact management needs migration020; no messaging provider is enabled.
# Gallery uses the existing VISION_API_BASE_URL and same-user Supabase JWT path.
